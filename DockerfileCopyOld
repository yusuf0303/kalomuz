# PHP 8.3 asosidagi rasmni tanlaymiz
FROM php:8.3-fpm

# Asosiy tizim kutubxonalarini o‘rnatamiz
RUN apt-get update && apt-get install -y \
    git \
    curl \
    zip \
    unzip \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && docker-php-ext-install pdo pdo_mysql zip mbstring exif pcntl bcmath gd

# Composer o‘rnatamiz
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Ishchi katalogni yaratamiz
WORKDIR /var/www/html

# Laravel fayllarini konteynerga nusxalaymiz
COPY . .

# Laravel permissionlarni o‘rnatamiz (storage & bootstrap/cache uchun)
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage /var/www/html/bootstrap/cache

# Composer orqali paketlarni o‘rnatamiz
RUN composer install --no-interaction --prefer-dist --optimize-autoloader

# Laravel key yaratish (agar kerak bo‘lsa)
# RUN php artisan key:generate

# 8000-portda artisan serve ishlaydi (docker-compose orqali ishga tushadi)
EXPOSE 8000

# Default komandani artisan serve sifatida belgilamaymiz – docker-compose'da ko'rsatilgan

